# Python cache files
__pycache__/
*.py[cod]

# Virtual environments and local secrets
.venv/
venv/
.env

# Temporary and log files
*.tmp
*.log

# OS files
.DS_Store
Thumbs.db

# Excel temporary files
~$*.xlsx

# Real operating data / private business data
data/private/**
output/private/**
output/final/**
local_config/**

